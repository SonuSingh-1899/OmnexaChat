# Optional environment overrides for backend.
# Spring Boot will read these when you export them in your terminal / IDE run config.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION=86400000

DB_URL=jdbc:postgresql://localhost:5432/chat_in_public
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Omnexa

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
CHAT_MESSAGE_RETENTION_DAYS=3
